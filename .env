# Só o VITE_SITE_URL é lido no build. Os outros três valem só no `npm run dev`:
# em produção vêm das variáveis de ambiente do container (stack no Portainer), via /env.js.

# Endereço público da página, sem barra no fim. Usado na capa de compartilhamento (og:image).
# Tem que ser o mesmo do Host() no docker-stack.yml.
VITE_SITE_URL=https://evento.elianearainhadocredito.com

# Container do GTM (ex.: GTM-XXXXXXX). Vazio = GTM não carrega.
VITE_GTM_ID=

# Webhook que recebe o lead (POST JSON). Vazio = formulário mostra erro e não envia.
VITE_WEBHOOK_URL=

# Para onde o lead vai depois de enviar (link wa.me ou do grupo). Vazio = só mostra a confirmação na página.
VITE_WHATSAPP_URL=
